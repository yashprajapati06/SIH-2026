# ==============================================================================
# SENTINEL NER — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development. Never commit real credentials to VCS.
# ==============================================================================

# Core System
APP_ENV=development
APP_NAME=sentinel-ner
API_PORT=8000
API_HOST=0.0.0.0
DEBUG=false
LOG_LEVEL=INFO

# Security
# In production, SECRET_KEY must be a cryptographically random string (min 32 chars)
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Primary Operational Database (MongoDB Atlas / Local)
MONGODB_URI=mongodb://localhost:27017/sentinel_ner
MONGODB_DB_NAME=sentinel_ner
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=50

# Asynchronous Work & Caching (Redis)
REDIS_URL=redis://localhost:6379/0

# Object Storage (AWS S3)
STORAGE_BACKEND=s3
AWS_REGION=eu-north-1
AWS_S3_BUCKET=sentinel-ner-production-okayyyabhishek
S3_BUCKET_NAME=sentinel-ner-production-okayyyabhishek
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SATELLITE_STORAGE_DIR=apps/api/storage/satellite

# Satellite Subsystem & Copernicus CDSE STAC
SATELLITE_MODE=production
SATELLITE_PROVIDER=copernicus
COPERNICUS_STAC_URL=https://stac.dataspace.copernicus.eu/v1
COPERNICUS_AUTH_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_COLLECTION=sentinel-2-l2a
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# External Feeds & Adapters (Health & Connectivity placeholders)
GSI_NLFC_ENABLED=false
IMD_API_ENABLED=false
ISRO_BHUVAN_ENABLED=false
BHASHINI_ENABLED=false

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
# Separate Sentinel Mini service; set an HTTPS origin before a production build.
NEXT_PUBLIC_CHATBOT_URL=http://127.0.0.1:8046

# Basemap Configuration (Zero credentials required by default)
# Default: OpenStreetMap with tactical dark styling (NEXT_PUBLIC_BASEMAP_PROVIDER=osm)
# Optional CARTO: Obtain free API key from https://carto.com/basemaps/apikey
NEXT_PUBLIC_BASEMAP_PROVIDER=osm
NEXT_PUBLIC_CARTO_API_KEY=
NEXT_PUBLIC_BASEMAP_TILE_URL=
NEXT_PUBLIC_BASEMAP_ATTRIBUTION=
